DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_SETUP_TOKEN=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Leave DATABASE_URL blank for a real local SQLite database. For shared deployments, set PostgreSQL:
# DATABASE_URL=postgresql://compta:change-me@localhost:5432/comptapieces
DATABASE_URL=
PRIVATE_MEDIA_ROOT=private_media
# Prefer the full CLOUDINARY_URL copied from Console > Settings > API Keys.
# If blank, the three individual variables below are used instead.
CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
